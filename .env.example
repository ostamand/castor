# 🦫 Castor Local Development Environment
# Copy this file to .env to inject credentials during 'make build' or 'make install'

# Google OAuth 2.0 Desktop Client Credentials
CASTOR_GOOGLE_CLIENT_ID=
CASTOR_GOOGLE_CLIENT_SECRET=

# Dropbox OAuth 2.0 PKCE App Key (public identifier, no secret required)
CASTOR_DROPBOX_APP_KEY=
